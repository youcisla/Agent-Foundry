{
  "name": "@youcisla/agent-foundry",
  "version": "0.4.3",
  "mcpName": "io.github.youcisla/agent-foundry",
  "description": "Skill orchestrator for AI coding assistants. MIT-licensed, no third-party skill content, 35 original skills, quality-gated on every commit.",
  "type": "module",
  "main": "scripts/install.js",
  "bin": {
    "agent-foundry": "scripts/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "validate": "bash scripts/validate.sh",
    "eval": "python scripts/foundry-eval.py",
    "test:installer": "node scripts/test-install.js"
  },
  "files": [
    "agent_foundry",
    "skills",
    "agents",
    "AGENTS.md",
    ".claude-plugin",
    ".codex",
    ".cursor",
    ".gemini",
    ".opencode",
    ".antigravity",
    ".codebuddy",
    ".joycode",
    ".qwen",
    ".kimi",
    ".openclaw",
    ".zed",
    "docs/harness-compatibility.md",
    "hooks",
    "scripts/install.js",
    "scripts/install.sh",
    "scripts/install.bat",
    "scripts/install.ps1",
    "**/__pycache__",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "keywords": [
    "skills",
    "agents",
    "orchestrator",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT"
}
